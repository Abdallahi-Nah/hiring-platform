# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Also signs applicant session cookies.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (required) ---
GROQ_API_KEY=
# Optional model overrides
TRANSCRIBE_MODEL=
CLEAN_MODEL=
PARSE_MODEL=

# --- Email through Gmail SMTP (required) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional sender, e.g. Company <hr@example.com>
EMAIL_FROM=

# --- Cron (required): Bearer secret that protects /api/cron/* ---
CRON_SECRET=

# --- Production ---
# Public URL used in email links, e.g. https://jobs.example.com
NEXT_PUBLIC_SITE_URL=
# Platform name on public pages (default: Hiring Platform)
NEXT_PUBLIC_COMPANY_NAME=
